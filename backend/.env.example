# Port the API listens on (the React dev server proxies /api here)
PORT=5000

# MongoDB connection string.
#   MongoDB on another laptop (same Wi-Fi): mongodb://<OTHER_LAPTOP_IP>:27017/agrisense
#   With auth enabled:                     mongodb://agrisense:<password>@<OTHER_LAPTOP_IP>:27017/agrisense?authSource=admin
#   MongoDB Atlas (cloud):                 mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agrisense
MONGO_URI=mongodb://127.0.0.1:27017/agrisense

# Secret used to sign login tokens. Change this to any long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend URL allowed by CORS (comma-separate multiple)
CLIENT_ORIGIN=http://localhost:5173

# Create demo@agrisense.com / demo1234 automatically on first start (set false to disable)
SEED_DEMO=true
